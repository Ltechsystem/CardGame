<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CardGame.GoFish"
             xmlns:models="using:CardGame.Models"
             x:Class="CardGame.GoFish.GoFishView"
             x:DataType="vm:GoFishViewModel">

    <Panel Background="#1A472A">
        <Grid RowDefinitions="Auto,*,Auto" Margin="24,16">

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                <Button Grid.Column="0" Content="← MENU" Command="{Binding BackToMenuCommand}" Padding="12,8"/>
                <TextBlock Grid.Column="1" Text="GO FISH" FontSize="22" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Game area -->
            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*">

                <!-- AI section -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <!-- AI hand (face-down card backs) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="AI HAND" Foreground="#9E9E9E" FontSize="11"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ItemsControl ItemsSource="{Binding PlayerHand}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="-28"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Card">
                                    <Border Width="40" Height="58" Background="#1E3A5F" CornerRadius="5"
                                            BorderBrush="#2E5A8F" BorderThickness="1"
                                            BoxShadow="0 2 4 0 #60000000">
                                        <TextBlock Text="★" FontSize="16" Foreground="#2E5A8F"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding AiHandCount, StringFormat='{}{0} cards'}"
                                   Foreground="#9E9E9E" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- AI sets -->
                    <Border Grid.Column="1" Background="#00000050" CornerRadius="8" Padding="14,8">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <TextBlock Text="AI SETS" Foreground="#9E9E9E" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding AiSets}" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Action log -->
                <Border Grid.Row="1" Background="#00000050" CornerRadius="8" Padding="20,14" Margin="0,0,0,16">
                    <TextBlock Text="{Binding ActionLog}" Foreground="White"
                               FontSize="14" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>

                <!-- Player hand -->
                <Grid Grid.Row="2" RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Grid.Column="0"
                                   Text="YOUR HAND — select a card to ask for its rank"
                                   Foreground="#9E9E9E" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsPlayingPhase}"/>
                        <Border Grid.Column="1" Background="#00000050" CornerRadius="8" Padding="14,8">
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="YOUR SETS" Foreground="#9E9E9E" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding PlayerSets}" Foreground="#E0C87A" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding PlayerHand}"
                             SelectedItem="{Binding SelectedCard}"
                             SelectionMode="Single"
                             IsVisible="{Binding IsPlayingPhase}"
                             Background="Transparent"
                             Padding="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Card">
                                <Border Width="50" Height="74" Background="White" CornerRadius="6"
                                        Padding="7,5" Margin="4"
                                        BoxShadow="0 2 6 0 #60000000">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RankSymbol}"
                                                   FontSize="17" FontWeight="Bold"
                                                   Foreground="#1A1A1A"/>
                                        <TextBlock Text="{Binding SuiteSymbol}"
                                                   FontSize="15"
                                                   Foreground="#CC2200"
                                                   IsVisible="{Binding IsRed}"/>
                                        <TextBlock Text="{Binding SuiteSymbol}"
                                                   FontSize="15"
                                                   Foreground="#1A1A1A"
                                                   IsVisible="{Binding !IsRed}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Result -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding ResultMessage}"
                               Foreground="#E0C87A"
                               FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding IsResultPhase}"/>
                </Grid>
            </Grid>

            <!-- Bottom controls -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Spacing="12" Margin="0,12,0,0">
                <Button Content="ASK!" Command="{Binding AskCommand}"
                        IsVisible="{Binding IsPlayingPhase}"
                        Background="#E0C87A" Foreground="#1E1E1E"
                        FontWeight="Bold" FontSize="16" Padding="32,12" CornerRadius="8"/>
                <Button Content="BACK TO MENU" Command="{Binding BackToMenuCommand}"
                        FontSize="15" Padding="24,10" CornerRadius="8"/>
            </StackPanel>

        </Grid>
    </Panel>

</UserControl>
