<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CardGame.ViewModels"
             x:Class="CardGame.Views.MainMenuView"
             x:DataType="vm:MainMenuViewModel">

    <Panel Background="#1A472A">
        <Border Background="#1E1E1E"
                CornerRadius="16"
                Padding="48,40"
                MaxWidth="560"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                BoxShadow="0 8 40 0 #A0000000">

            <StackPanel Spacing="24">

                <!-- Title + chip balance -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="♠  ♥  ♣  ♦"
                                   FontSize="22"
                                   Foreground="#E0C87A"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="CARD GAMES"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="#00000050"
                            CornerRadius="8"
                            Padding="14,10"
                            VerticalAlignment="Center"
                            IsVisible="{Binding !HasNoGames}">
                        <StackPanel Spacing="2" HorizontalAlignment="Center">
                            <TextBlock Text="CHIPS"
                                       Foreground="#9E9E9E"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ChipBalance}"
                                       Foreground="#E0C87A"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Player Name -->
                <StackPanel Spacing="8">
                    <TextBlock Text="PLAYER NAME"
                               Foreground="#9E9E9E"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                    <TextBox Text="{Binding PlayerName}"
                             Watermark="Enter your name…"
                             FontSize="15"/>
                </StackPanel>

                <!-- No games message -->
                <Border IsVisible="{Binding HasNoGames}"
                        Background="#2A2A2A"
                        CornerRadius="8"
                        Padding="16,20">
                    <TextBlock Text="No games found"
                               Foreground="#9E9E9E"
                               FontSize="14"
                               FontWeight="Medium"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Casino games -->
                <StackPanel IsVisible="{Binding HasCasinoGames}" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="♠"
                                   Foreground="#E0C87A"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="CASINO GAMES"
                                   Foreground="#9E9E9E"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding CasinoGames}"
                             SelectedItem="{Binding SelectedCasinoGame}"
                             SelectionMode="Single"
                             Background="Transparent"
                             Padding="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameOption">
                                <TextBlock Text="{Binding DisplayName}"
                                           HorizontalAlignment="Center"
                                           Padding="4,8"
                                           FontWeight="Medium"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- Non-casino games -->
                <StackPanel IsVisible="{Binding HasNonCasinoGames}" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="♣"
                                   Foreground="#9E9E9E"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="CARD GAMES"
                                   Foreground="#9E9E9E"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding NonCasinoGames}"
                             SelectedItem="{Binding SelectedNonCasinoGame}"
                             SelectionMode="Single"
                             Background="Transparent"
                             Padding="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameOption">
                                <TextBlock Text="{Binding DisplayName}"
                                           HorizontalAlignment="Center"
                                           Padding="4,8"
                                           FontWeight="Medium"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- Difficulty -->
                <StackPanel Spacing="8">
                    <TextBlock Text="DIFFICULTY"
                               Foreground="#9E9E9E"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                    <ListBox ItemsSource="{Binding AvailableDifficulties}"
                             SelectedItem="{Binding SelectedDifficulty}"
                             SelectionMode="Single"
                             Background="Transparent"
                             Padding="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DifficultyOption">
                                <TextBlock Text="{Binding DisplayName}"
                                           HorizontalAlignment="Center"
                                           Padding="4,8"
                                           FontWeight="Medium"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Spacing="10">
                    <Button Content="PLAY"
                            Command="{Binding StartGameCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Padding="0,14"
                            Background="#E0C87A"
                            Foreground="#1E1E1E"
                            CornerRadius="8"/>
                    <Button Content="HIGHSCORES"
                            Command="{Binding ViewHighscoresCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            FontSize="14"
                            Padding="0,12"
                            CornerRadius="8"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Panel>

</UserControl>
